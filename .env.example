# Ligação ao PostgreSQL (no Render usa o "Internal Database URL")
DATABASE_URL=postgres://utilizador:password@localhost:5432/rodagem

# Segredo que protege o endpoint /api/cron/alertas
CRON_SECRET=muda-isto

# Opcional: envio do resumo de alertas por email (https://resend.com)
RESEND_API_KEY=
ALERT_EMAIL_FROM=Rodagem <alertas@o-teu-dominio.pt>
